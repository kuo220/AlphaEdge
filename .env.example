# 📁 .env.example

# .env.example
# -----------------------------------------
# This is a template file for environment variables.
# Copy this file to `.env` and fill in the appropriate values.
#
# Usage:
#   cp .env.example .env
#
# The `.env` file will be loaded by Python (e.g., via `python-dotenv`)
# to configure paths, credentials, and environment-specific settings.
#
# ⚠️ Do NOT commit your actual `.env` file to Git.
# -----------------------------------------


# DolphinDB server settings
DDB_PATH=dfs://
DDB_HOST=localhost
DDB_PORT=8848
DDB_USER=admin
DDB_PASSWORD=your_password_here


# Shioaji API
API_KEY=your_api_key
API_SECRET_KEY=your_api_secret_key

# FinMind API
FINMIND_API_TOKEN=your_finmind_api_token


# LINE Messaging API（LINE Notify 已於 2025-03-31 停止服務）
# 兩者任一缺少時推播會被跳過並警告一次，不影響下單流程
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_PUSH_TARGET_ID=your_user_or_group_id
